 import { CardGrid, fadeIn } from './media-row';
 
+/** Cards this near the screen are drawn; further out each holds its place empty. */
+// eslint-disable-next-line lingui/no-unlocalized-strings -- a root margin
+const DRAWN_MARGIN = '150% 0px';
+/** Drawn before they're first measured, so a grid's first screen shows at once. */
+const FIRST_DRAWN = 30;
+
+/**
+ * A grid's card, drawn only near the screen: a catalog pages on as it's
+ * scrolled, and every card it kept mounted would keep its elements and its
+ * artwork. Out of sight it keeps its height, or the grid's last known one.
+ */
+function GridCell({
+  index,
+  height,
+  children,
+}: {
+  index: number;
+  height: React.MutableRefObject<number>;
+  children: React.ReactNode;
+}) {
+  const ref = React.useRef<HTMLDivElement | null>(null);
+  const root = React.useContext(ScrollRoot);
+  const [shown, setShown] = React.useState(index < FIRST_DRAWN);
+  const [held, setHeld] = React.useState<number>();
+  const fade = fadeIn(index).ref;
+  const setRef = React.useCallback(
+    (el: HTMLDivElement | null) => {
+      ref.current = el;
+      fade(el);
+    },
+    [fade]
+  );
+  React.useEffect(() => {
+    const el = ref.current;
+    if (!el) return;
+    return watch(el, root, DRAWN_MARGIN, (entry) => {
+      if (entry.isIntersecting) return setShown(true);
+      // Measured already, so reading it costs nothing.
+      const h = entry.boundingClientRect.height;
+      if (h > 0) {
+        height.current = h;
+        setHeld(h);
+      }
+      setShown(false);
+    });
+  }, [root, height]);
+  return (
+    <div
+      ref={setRef}
+      style={
+        shown ? undefined : { height: held ?? (height.current || undefined) }
+      }
+    >
+      {shown ? children : null}
+    </div>
+  );
+}
